{
  "name": "Bazaar Calculator",
  "short_name": "Bazaar",
  "description": "Calculator with unit, currency, land, container and shop price tools",
  "start_url": "./index.html",
  "scope": "./",
  "id": "./index.html",
  "display": "standalone",
  "background_color": "#F5F5F5",
  "theme_color": "#1F5163",
  "icons": [
    {
      "src": "bazaarcalc_logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "bazaarcalc_logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait"
}
